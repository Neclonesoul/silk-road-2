{
  "name": "silk-road-2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A premium mobile-first marketplace for direct local trade.",
  "overrides": {
    "cookie": "^1.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/append-worker-exports.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "npm run check && npm run lint && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply silk-road-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply silk-road-db --remote",
    "deploy": "wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0",
    "svelte": "^5.38.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "eslint-plugin-svelte": "^3.12.0",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "prettier-plugin-tailwindcss": "0.6.14",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.125.0"
  }
}
